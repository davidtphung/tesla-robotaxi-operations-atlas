# Optional. The app runs in demo mode with no keys.

# Vector basemap style JSON (OpenFreeMap, MapTiler, self-hosted, etc.)
# If unset, a dark/light Carto raster fallback is used (no key).
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=
NEXT_PUBLIC_MAP_STYLE_URL_LIGHT=

# Satellite layer — only enable the toggle when one of these is set.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Authorized live vehicle feed. Leave empty to keep SIMULATED mode.
# The client will never invent a live Tesla telemetry API.
NEXT_PUBLIC_LIVE_VEHICLE_ENDPOINT=

# Optional licensed traffic overlay. The layer stays disabled without a key.
NEXT_PUBLIC_TRAFFIC_API_KEY=
NEXT_PUBLIC_TRAFFIC_ENDPOINT=

# Optional weather context. Unused by the simulation engine.
NEXT_PUBLIC_WEATHER_API_KEY=
NEXT_PUBLIC_WEATHER_ENDPOINT=

# Optional remote regulatory JSON. Falls back to curated seed notes.
REGULATORY_FEED_URL=
